{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node preview/repo-data.js --hook", "timeout": 40 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node preview/repo-data.js --changes", "timeout": 30 }
        ]
      }
    ]
  }
}
