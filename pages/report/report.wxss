.hero {
  position: relative; overflow: hidden; color: #fff;
  background: var(--hero);
  padding-left: 32rpx; padding-right: 32rpx; padding-bottom: 110rpx;
}
.hero::before { content: ''; position: absolute; width: 420rpx; height: 420rpx; right: -140rpx; top: -120rpx; border-radius: 50%; background: rgba(255,255,255,.06); }
.navrow { display: flex; align-items: center; }
.brand { display: flex; align-items: center; gap: 14rpx; font-size: 30rpx; font-weight: 700; }
.logo { width: 56rpx; height: 56rpx; border-radius: 18rpx; background: rgba(255,255,255,.16); display: flex; align-items: center; justify-content: center; }
.hero-title { font-size: 60rpx; font-weight: 800; margin-top: 24rpx; letter-spacing: -1rpx; }
.hero-sub { font-size: 25rpx; opacity: .75; margin-top: 4rpx; }
.hero-total { position: relative; z-index: 1; margin-top: 32rpx; display: flex; align-items: center; justify-content: space-between; background: rgba(255,255,255,.12); border: 1rpx solid rgba(255,255,255,.16); border-radius: 28rpx; padding: 26rpx 28rpx; }
.ht-k { font-size: 22rpx; opacity: .75; }
.ht-v { display: flex; flex-wrap: wrap; gap: 8rpx 28rpx; margin-top: 6rpx; font-size: 44rpx; font-weight: 800; }
.ht-icon { width: 84rpx; height: 84rpx; border-radius: 26rpx; background: rgba(255,255,255,.16); display: flex; align-items: center; justify-content: center; }

.body { margin-top: -72rpx; position: relative; z-index: 2; }
.kpis { display: flex; flex-wrap: wrap; gap: 20rpx; margin-bottom: 24rpx; }
.kpi { width: calc(50% - 10rpx); box-sizing: border-box; background: var(--card); border-radius: var(--radius); padding: 26rpx; box-shadow: var(--shadow); }
.kpi-v { font-size: 48rpx; font-weight: 800; margin-top: 18rpx; line-height: 1.1; }
.kpi-k { font-size: 23rpx; color: var(--ink-2); font-weight: 600; }
.icon-tile.c1 { background: var(--mint-2); }
.icon-tile.c2 { background: rgba(245,158,11,.18); }
.icon-tile.c3 { background: rgba(99,102,241,.14); }
.icon-tile.c4 { background: rgba(225,29,72,.12); }

.exports { display: flex; gap: 20rpx; }
.export { flex: 1; border-radius: 28rpx; padding: 28rpx; border: 2rpx solid var(--line); }
.export.pdf { background: linear-gradient(160deg, rgba(225,29,72,.1), transparent 70%); border-color: rgba(225,29,72,.25); }
.export.xls { background: linear-gradient(160deg, rgba(22,163,74,.1), transparent 70%); border-color: rgba(22,163,74,.25); }
.ex-icon { width: 80rpx; height: 80rpx; border-radius: 24rpx; background: var(--card); display: flex; align-items: center; justify-content: center; box-shadow: 0 6rpx 16rpx rgba(15,23,42,.08); }
.ex-name { font-size: 34rpx; font-weight: 800; margin-top: 22rpx; }
.ex-sub { font-size: 22rpx; color: var(--ink-2); margin-top: 4rpx; }
.ex-note { margin-top: 22rpx; line-height: 1.5; }

.mrow { padding: 20rpx 0; border-top: 1rpx solid var(--line); }
.mrow:first-of-type { border-top: none; }
.mrow-top { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.mname { font-size: 28rpx; font-weight: 700; flex: 1; min-width: 0; }
.mname.none { color: var(--ink-3); }
.mcount { font-size: 28rpx; font-weight: 800; color: var(--brand); }
.bar { height: 12rpx; border-radius: 999rpx; background: var(--soft); margin: 14rpx 0 10rpx; overflow: hidden; }
.bar.big { height: 16rpx; }
.fill { height: 100%; border-radius: 999rpx; background: linear-gradient(90deg, var(--brand-2), var(--brand)); transition: width .3s; }
.mmeta { font-size: 22rpx; color: var(--ink-2); }
.loc-line { font-size: 26rpx; color: var(--ink-2); }

.offscreen { position: fixed; left: -9999px; top: 0; width: 10px; height: 10px; }

.mask { position: fixed; inset: 0; z-index: 1000; background: rgba(15, 23, 42, .45); display: flex; align-items: center; justify-content: center; }
.mask.bottom { align-items: flex-end; }
.busy { width: 560rpx; background: var(--card); border-radius: 36rpx; padding: 48rpx 44rpx 36rpx; text-align: center; }
.busy-title { font-size: 30rpx; font-weight: 700; margin: 28rpx 0 10rpx; }
.spinner { width: 72rpx; height: 72rpx; margin: 0 auto; border-radius: 50%; border: 8rpx solid var(--mint-2); border-top-color: var(--brand); animation: spin .8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

.sheet { width: 100%; background: var(--card); border-radius: 44rpx 44rpx 0 0; padding: 20rpx 36rpx calc(36rpx + env(safe-area-inset-bottom)); text-align: center; }
.grip { width: 80rpx; height: 10rpx; border-radius: 999rpx; background: var(--line); margin: 0 auto 28rpx; }
.ok { width: 96rpx; height: 96rpx; border-radius: 50%; margin: 0 auto; background: linear-gradient(135deg, var(--brand-2), var(--brand)); display: flex; align-items: center; justify-content: center; box-shadow: 0 12rpx 28rpx rgba(var(--brand-rgb), .35); }
.sheet-title { font-size: 36rpx; font-weight: 800; margin: 22rpx 0 28rpx; }
.file { display: flex; align-items: center; gap: 22rpx; text-align: left; background: var(--field); border: 2rpx solid var(--line); border-radius: 26rpx; padding: 22rpx; }
.file .ex-icon.pdf { background: rgba(225,29,72,.1); box-shadow: none; }
.file .ex-icon.xlsx { background: rgba(22,163,74,.1); box-shadow: none; }
.file-info { flex: 1; min-width: 0; }
.file-name { font-size: 28rpx; font-weight: 700; }
.sheet-actions { display: flex; gap: 20rpx; margin-top: 28rpx; }
.sheet-actions .btn { flex: 1; }
.done { margin-top: 18rpx; padding: 18rpx; color: var(--ink-2); font-size: 28rpx; font-weight: 600; }

/* tabs */
.seg { display: flex; white-space: nowrap; background: var(--card); border-radius: 28rpx; padding: 8rpx; box-shadow: var(--shadow); margin-bottom: 24rpx; box-sizing: border-box; width: 100%; }
.seg-i { display: inline-block; flex-shrink: 0; padding: 18rpx 26rpx; border-radius: 20rpx; font-size: 25rpx; font-weight: 700; color: var(--ink-2); transition: all .25s; }
.seg-i.on { color: #fff; background: linear-gradient(135deg, var(--brand-2), var(--brand)); box-shadow: 0 8rpx 20rpx rgba(var(--brand-rgb), .3); }
.icon-tile.c1 { background: var(--mint-2); }

/* period chart + cards */
.chart { display: flex; align-items: flex-end; gap: 12rpx; height: 260rpx; padding-top: 12rpx; }
.col { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; height: 100%; gap: 10rpx; }
.col-bar { width: 100%; max-width: 60rpx; border-radius: 14rpx 14rpx 6rpx 6rpx; background: linear-gradient(180deg, var(--brand-2), var(--brand)); transform-origin: bottom; animation: rise calc(var(--dur) * 1.6) cubic-bezier(.2, .8, .2, 1) both; }
.col.on .col-bar { box-shadow: 0 0 0 6rpx rgba(var(--brand-rgb), .25); }
.col-n { font-size: 20rpx; font-weight: 800; color: var(--ink-2); }
.col-k { font-size: 19rpx; color: var(--ink-3); font-weight: 600; white-space: nowrap; }
.period { background: var(--card); border-radius: var(--radius); box-shadow: var(--shadow); margin-bottom: 22rpx; overflow: hidden; }
.period-head { display: flex; align-items: center; gap: 22rpx; padding: 26rpx 28rpx; }
.p-badge { width: 88rpx; height: 88rpx; border-radius: 26rpx; background: var(--mint); color: var(--brand); display: flex; flex-direction: column; align-items: center; justify-content: center; flex-shrink: 0; line-height: 1; }
.b1 { font-size: 32rpx; font-weight: 800; }
.b2 { font-size: 18rpx; font-weight: 700; text-transform: uppercase; margin-top: 4rpx; }
.p-main { flex: 1; min-width: 0; }
.p-title { font-size: 30rpx; font-weight: 800; }
.p-meta { font-size: 23rpx; color: var(--ink-2); margin-top: 4rpx; }
.p-total { font-size: 26rpx; font-weight: 800; color: var(--price); text-align: right; white-space: nowrap; }
.chev { transition: transform .3s; }
.period.open .chev { transform: rotate(90deg); }
.p-body { padding: 0 28rpx 28rpx; animation: pageIn .3s cubic-bezier(.2, .8, .2, 1); }

/* same products */
.sim-note { line-height: 1.5; margin: -8rpx 0 20rpx; }
.modes { display: flex; gap: 12rpx; flex-wrap: wrap; }
.g-head { margin-bottom: 8rpx; align-items: flex-start; }
.chips { display: flex; flex-wrap: wrap; gap: 10rpx; }
.strip { display: flex; white-space: nowrap; margin: 20rpx 0 4rpx; width: 100%; }
.strip image, .strip .ph { width: 112rpx; height: 112rpx; border-radius: 22rpx; margin-right: 12rpx; flex-shrink: 0; background: var(--soft); display: inline-flex; align-items: center; justify-content: center; box-sizing: border-box; }
.strip .best { border: 4rpx solid #22C55E; }
.sim-wait { margin-top: 20rpx; }
.progress { animation: none; }
.sheet-actions + .sheet-actions { margin-top: 18rpx; }
