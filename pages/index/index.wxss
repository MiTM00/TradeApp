.hero {
  position: relative; overflow: hidden;
  background: var(--hero);
  padding-left: 32rpx; padding-right: 32rpx; padding-bottom: 96rpx; color: #fff;
}
.hero::before, .hero::after { content: ''; position: absolute; border-radius: 50%; background: rgba(255, 255, 255, .06); }
.hero::before { width: 420rpx; height: 420rpx; right: -140rpx; top: -120rpx; }
.hero::after { width: 240rpx; height: 240rpx; right: 160rpx; bottom: -140rpx; }
.navrow { display: flex; align-items: center; }
.brand { display: flex; align-items: center; gap: 14rpx; font-size: 30rpx; font-weight: 700; letter-spacing: 1rpx; }
.logo { width: 56rpx; height: 56rpx; border-radius: 18rpx; background: rgba(255, 255, 255, .16); display: flex; align-items: center; justify-content: center; }
.hero-title { font-size: 60rpx; font-weight: 800; margin-top: 24rpx; letter-spacing: -1rpx; }
.hero-sub { font-size: 25rpx; opacity: .75; margin-top: 4rpx; }
.stats { display: flex; gap: 18rpx; margin-top: 32rpx; position: relative; z-index: 1; }
.stat { flex: 1; background: rgba(255, 255, 255, .12); border: 1rpx solid rgba(255, 255, 255, .16); border-radius: 24rpx; padding: 18rpx 22rpx; }
.stat-v { font-size: 40rpx; font-weight: 800; }
.stat-k { font-size: 21rpx; opacity: .75; }

.search-wrap { padding: 0 32rpx; margin-top: -48rpx; position: relative; z-index: 2; }
.search {
  display: flex; align-items: center; gap: 16rpx; height: 96rpx; padding: 0 28rpx;
  background: var(--card); border-radius: 28rpx; box-shadow: 0 16rpx 40rpx rgba(15, 23, 42, .12);
}
.search input { flex: 1; font-size: 28rpx; color: var(--ink); }
.clear { width: 44rpx; height: 44rpx; border-radius: 50%; background: var(--soft); display: flex; align-items: center; justify-content: center; }

.filters { white-space: nowrap; display: flex; padding: 28rpx 32rpx 4rpx; box-sizing: border-box; width: 100%; }
.filter {
  display: inline-flex; align-items: center; gap: 10rpx; flex-shrink: 0; margin-right: 16rpx;
  height: 64rpx; padding: 0 26rpx; border-radius: 999rpx; font-size: 25rpx; font-weight: 600;
  background: var(--card); color: var(--ink-2); border: 2rpx solid var(--line);
}
.filter .n { font-size: 21rpx; color: var(--ink-3); }
.filter.on { background: var(--brand); color: #fff; border-color: var(--brand); box-shadow: 0 8rpx 20rpx rgba(var(--brand-rgb), .3); }
.filter.on .n { color: rgba(255, 255, 255, .6); }

.list { padding-top: 24rpx; }
.empty { text-align: center; padding: 72rpx 48rpx; }
.empty-art { width: 140rpx; height: 140rpx; border-radius: 44rpx; background: var(--mint); display: flex; align-items: center; justify-content: center; margin: 0 auto 28rpx; }
.empty-title { font-size: 34rpx; font-weight: 800; margin-bottom: 10rpx; }
.empty-btn { margin: 40rpx auto 0; width: 360rpx; }

.pcard {
  display: flex; gap: 24rpx; background: var(--card); border-radius: var(--radius); padding: 20rpx;
  margin-bottom: 22rpx; box-shadow: var(--shadow);
}
.pcard-hover { transform: scale(.985); opacity: .92; }
.thumb { position: relative; width: 236rpx; height: 236rpx; border-radius: 24rpx; overflow: hidden; flex-shrink: 0; background: var(--soft); }
.thumb image { width: 100%; height: 100%; display: block; }
.thumb-ph { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, var(--field), var(--line)); }
.thumb-count { position: absolute; left: 12rpx; bottom: 12rpx; display: flex; align-items: center; gap: 6rpx; padding: 4rpx 14rpx; border-radius: 999rpx; background: rgba(15, 23, 42, .55); color: #fff; font-size: 20rpx; font-weight: 600; }
.body { flex: 1; min-width: 0; display: flex; flex-direction: column; padding: 6rpx 4rpx 4rpx 0; }
.name { font-size: 31rpx; font-weight: 700; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.chips { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 12rpx; }
.where { display: flex; align-items: center; gap: 8rpx; margin-top: 12rpx; font-size: 23rpx; color: var(--ink-2); min-width: 0; }
.where.date { margin-top: 6rpx; color: var(--ink-3); font-size: 22rpx; }
.bottom { margin-top: auto; display: flex; align-items: flex-end; justify-content: space-between; padding-top: 10rpx; }
.price { color: var(--price); font-size: 40rpx; font-weight: 800; line-height: 1; }
.price .cur { font-size: 26rpx; margin-right: 2rpx; }
.price .dec { font-size: 26rpx; }
.price .per { font-size: 22rpx; color: var(--ink-3); font-weight: 500; }
.go { width: 52rpx; height: 52rpx; border-radius: 18rpx; background: var(--mint); display: flex; align-items: center; justify-content: center; }
.pdesc { font-size: 23rpx; color: var(--ink-3); margin-top: 4rpx; }
