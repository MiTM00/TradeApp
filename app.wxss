/* ---------- Design tokens ---------- */
page {
  --ink: #0F172A;
  --ink-2: #475569;
  --ink-3: #94A3B8;
  --line: #E9EDF2;
  --bg: #F5F7FA;
  --card: #FFFFFF;
  --brand: #0F766E;
  --brand-2: #14B8A6;
  --brand-dark: #134E4A;
  --mint: #F0FDFA;
  --mint-2: #CCFBF1;
  --price: #E11D48;
  --amber: #F59E0B;
  --soft: #F1F5F9;
  --field: #F8FAFC;
  --ph: #B6C0CD;
  --tabbar: rgba(255, 255, 255, .96);
  --brand-rgb: 15, 118, 110;
  --hero: linear-gradient(150deg, #0F766E 0%, #134E4A 100%);
  --dur: .5s;
  --radius: 32rpx;
  --shadow: 0 2rpx 4rpx rgba(16, 24, 40, .03), 0 12rpx 32rpx rgba(16, 24, 40, .06);

  background: var(--bg);
  color: var(--ink);
  font-size: 30rpx;
  line-height: 1.4;
  font-family: -apple-system, "SF Pro Text", "PingFang SC", "Helvetica Neue", sans-serif;
}

/* ---------- Layout ---------- */
.page { padding: 24rpx 32rpx 200rpx; }
.tab-page { padding-bottom: calc(200rpx + env(safe-area-inset-bottom)); }

.card {
  background: var(--card);
  border-radius: var(--radius);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
}
.card-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.card-title { display: flex; align-items: center; gap: 14rpx; font-size: 30rpx; font-weight: 700; }
.icon-tile { width: 60rpx; height: 60rpx; border-radius: 18rpx; display: flex; align-items: center; justify-content: center; background: var(--mint); flex-shrink: 0; }

/* ---------- Text ---------- */
.label { font-size: 24rpx; color: var(--ink-2); margin-bottom: 12rpx; font-weight: 600; }
.req { color: var(--price); }
.hint { font-size: 22rpx; color: var(--ink-3); font-weight: 400; }
.muted { color: var(--ink-3); font-size: 26rpx; }
.ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* ---------- Chips ---------- */
.chip { display: inline-flex; align-items: center; gap: 6rpx; font-size: 21rpx; font-weight: 600; padding: 6rpx 16rpx; border-radius: 999rpx; background: var(--soft); color: var(--ink-2); white-space: nowrap; }
.chip.teal { background: var(--mint-2); color: var(--brand); }

/* ---------- Buttons ---------- */
.btn {
  height: 96rpx; border-radius: 26rpx; display: flex; align-items: center; justify-content: center; gap: 12rpx;
  font-size: 30rpx; font-weight: 700; background: var(--soft); color: var(--ink);
}
.btn.primary { background: linear-gradient(135deg, var(--brand-2), var(--brand)); color: #fff; box-shadow: 0 12rpx 28rpx rgba(var(--brand-rgb), .3); }
.btn.soft { background: var(--mint); color: var(--brand); }
.btn.danger { background: rgba(225,29,72,.1); color: var(--price); }
.btn.disabled { opacity: .5; }
.btn-hover { opacity: .85; transform: scale(.985); }

/* ---------- Form ---------- */
.input {
  background: var(--field); border: 2rpx solid var(--line); border-radius: 22rpx;
  height: 92rpx; padding: 0 28rpx; font-size: 29rpx; color: var(--ink);
}
.input-ph { color: var(--ph); }

/* ---------- Motion (length comes from --dur; 0s when animations are off) ---------- */
@keyframes pageIn { from { opacity: 0; transform: translateY(28rpx); } }
@keyframes cardIn { from { opacity: 0; transform: translateY(36rpx) scale(.98); } }
@keyframes grow { from { transform: scaleX(0); } }
@keyframes rise { from { transform: scaleY(0); } }
@keyframes zoom { from { opacity: 0; transform: scale(.88); } }
@keyframes up { from { transform: translateY(100%); } }
@keyframes fade { from { opacity: 0; } }
@keyframes float { 50% { transform: translateY(-12rpx); } }
@keyframes drift { to { transform: translate(-36rpx, 28rpx) scale(1.08); } }
.page, .search-wrap, .seg { animation: pageIn var(--dur) cubic-bezier(.2, .8, .2, 1) both; }
.anim-card { animation: cardIn var(--dur) cubic-bezier(.2, .8, .2, 1) both; }
.fill { transform-origin: left; animation: grow calc(var(--dur) * 1.8) cubic-bezier(.2, .8, .2, 1) both; }
.empty-art { animation: float 3s ease-in-out infinite; }
.mask { animation: fade .2s; }
.busy, .dialog { animation: zoom .25s cubic-bezier(.2, .8, .2, 1); }
.sheet-up { animation: up .3s cubic-bezier(.2, .8, .2, 1); }

/* ---------- Shared hero (markets, settings) ---------- */
.hero { position: relative; overflow: hidden; background: var(--hero); color: #fff; padding-left: 32rpx; padding-right: 32rpx; padding-bottom: 110rpx; }
.hero::before, .hero::after { content: ''; position: absolute; border-radius: 50%; background: rgba(255, 255, 255, .07); animation: drift 9s ease-in-out infinite alternate; }
.hero::before { width: 420rpx; height: 420rpx; right: -140rpx; top: -120rpx; }
.hero::after { width: 240rpx; height: 240rpx; right: 160rpx; bottom: -140rpx; }
.navrow { display: flex; align-items: center; position: relative; z-index: 1; }
.brand { display: flex; align-items: center; gap: 14rpx; font-size: 30rpx; font-weight: 700; }
.logo { width: 56rpx; height: 56rpx; border-radius: 18rpx; background: rgba(255, 255, 255, .16); display: flex; align-items: center; justify-content: center; }
.hero-title { font-size: 60rpx; font-weight: 800; margin-top: 24rpx; letter-spacing: -1rpx; position: relative; z-index: 1; }
.hero-sub { font-size: 25rpx; opacity: .78; margin-top: 4rpx; position: relative; z-index: 1; }
.stats { display: flex; gap: 18rpx; margin-top: 32rpx; position: relative; z-index: 1; }
.stat { flex: 1; background: rgba(255, 255, 255, .13); border: 1rpx solid rgba(255, 255, 255, .2); border-radius: 24rpx; padding: 18rpx 22rpx; }
.stat-v { font-size: 40rpx; font-weight: 800; }
.stat-k { font-size: 21rpx; opacity: .78; }
.lift { margin-top: -64rpx; position: relative; z-index: 2; }

/* ---------- Lists, chips, small rows ---------- */
.empty { text-align: center; padding: 72rpx 48rpx; }
.empty-art { width: 140rpx; height: 140rpx; border-radius: 44rpx; background: var(--mint); display: flex; align-items: center; justify-content: center; margin: 0 auto 28rpx; }
.empty-title { font-size: 34rpx; font-weight: 800; margin-bottom: 10rpx; }
.chip.green { background: rgba(34, 197, 94, .16); color: #16A34A; }
.mini { display: flex; align-items: center; gap: 20rpx; padding: 16rpx 0; border-top: 1rpx solid var(--line); }
.mini image, .mini .ph { width: 84rpx; height: 84rpx; border-radius: 20rpx; flex-shrink: 0; background: var(--soft); display: flex; align-items: center; justify-content: center; }
.mini-main { flex: 1; min-width: 0; }
.mini-name { font-size: 27rpx; font-weight: 700; }
.mini-sub { font-size: 22rpx; color: var(--ink-3); }
.mini-price { font-size: 27rpx; font-weight: 800; color: var(--price); white-space: nowrap; text-align: right; }
.row-btns { display: flex; gap: 16rpx; margin-top: 20rpx; }
.row-btns .btn { flex: 1; }
.btn.sm { height: 72rpx; font-size: 26rpx; border-radius: 20rpx; }
.qchip { display: inline-block; font-size: 24rpx; font-weight: 600; padding: 12rpx 22rpx; border-radius: 999rpx; background: var(--soft); color: var(--ink-2); max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; border: 2rpx solid transparent; transition: all .2s; }
.qchip.on { background: var(--brand); color: #fff; box-shadow: 0 6rpx 16rpx rgba(var(--brand-rgb), .3); }
.qchip.other { background: transparent; border: 2rpx dashed var(--ink-3); }
.qchip.other.on { background: var(--brand); border-color: var(--brand); }
.status { display: flex; align-items: center; gap: 18rpx; padding: 24rpx; border-radius: 26rpx; background: var(--mint); color: var(--brand); font-size: 26rpx; font-weight: 700; }

/* one language icon in every header */
.navrow { justify-content: space-between; }
.globe { display: flex; align-items: center; gap: 8rpx; height: 56rpx; padding: 0 18rpx 0 14rpx; border-radius: 999rpx; background: rgba(255, 255, 255, .16); font-size: 22rpx; font-weight: 700; color: #fff; position: relative; z-index: 2; }

/* registration date card */
.datecard { display: flex; gap: 26rpx; background: var(--card); border-radius: var(--radius); padding: 24rpx; box-shadow: var(--shadow); position: relative; overflow: hidden; margin-bottom: 24rpx; }
.dc-cal { width: 132rpx; flex-shrink: 0; border-radius: 28rpx; overflow: hidden; text-align: center; background: var(--card); box-shadow: 0 8rpx 24rpx rgba(var(--brand-rgb), .18), inset 0 0 0 2rpx var(--line); }
.dc-mon { background: linear-gradient(135deg, var(--brand-2), var(--brand)); color: #fff; font-size: 22rpx; font-weight: 800; padding: 8rpx 0; }
.dc-day { font-size: 56rpx; font-weight: 800; line-height: 1.1; padding-top: 6rpx; }
.dc-year { font-size: 20rpx; font-weight: 700; color: var(--ink-3); padding-bottom: 10rpx; }
.dc-main { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: center; }
.dc-k { display: flex; align-items: center; gap: 10rpx; font-size: 22rpx; font-weight: 700; color: var(--brand); }
.dc-date { font-size: 30rpx; font-weight: 800; margin-top: 6rpx; }
.dc-meta { display: flex; align-items: center; gap: 16rpx; margin-top: 10rpx; }
.dc-time { font-size: 24rpx; font-weight: 700; color: var(--ink-2); }
.dc-ago { font-size: 22rpx; font-weight: 700; color: var(--brand); background: var(--mint); padding: 4rpx 16rpx; border-radius: 999rpx; }
.dc-note { font-size: 22rpx; color: var(--ink-3); margin-top: 8rpx; }
.dchip { display: inline-flex; align-items: center; gap: 8rpx; font-size: 21rpx; font-weight: 600; color: var(--ink-2); background: var(--soft); padding: 4rpx 16rpx 4rpx 12rpx; border-radius: 999rpx; }
.wxchip { display: inline-flex; align-items: center; gap: 6rpx; font-size: 20rpx; font-weight: 700; color: #16A34A; background: rgba(22, 163, 74, .1); padding: 4rpx 14rpx; border-radius: 999rpx; margin-left: 8rpx; }
